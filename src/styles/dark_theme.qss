/* ==========================================================================
   AutoClicker-Pro — Modern Dark Theme (Slate & Electric Blue)
   ========================================================================== */

/* --- GLOBALS --- */
* {
    color: #E2E8F0;
    font-family: 'Segoe UI', 'Inter', 'San Francisco', 'Roboto', sans-serif;
    font-size: 13px;
    background-color: transparent;
    border: none;
    outline: none;
}

/* Base Window Background */
QMainWindow, QDialog, QWidget#centralwidget {
    background-color: #0B0F17;
}

QToolTip {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 10px;
}

/* --- SIDEBAR NAVIGATION --- */
QFrame#sidebar {
    background-color: #111827;
    border-right: 1px solid #1E293B;
}

QLabel#AppLogo {
    font-size: 19px;
    font-weight: 800;
    color: #F8FAFC;
    letter-spacing: 0.3px;
}

QLabel#AppSubtitle {
    font-size: 10px;
    font-weight: 700;
    color: #64748B;
    letter-spacing: 1.2px;
}

QLabel#NavCategory {
    font-size: 10px;
    font-weight: 700;
    color: #475569;
    letter-spacing: 1.1px;
    padding: 8px 12px 4px 12px;
}

/* Sidebar Navigation Buttons (match both #NavButton ID and .NavButton class) */
QPushButton#NavButton, QPushButton.NavButton {
    text-align: left;
    padding: 11px 14px;
    font-size: 13px;
    font-weight: 600;
    color: #94A3B8;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    margin: 2px 4px;
}

QPushButton#NavButton:hover, QPushButton.NavButton:hover {
    background-color: #1E293B;
    color: #F1F5F9;
    border: 1px solid #334155;
}

QPushButton#NavButton:checked, QPushButton.NavButton:checked {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #3B82F6;
    font-weight: 700;
}

/* Sidebar Footer Card */
QFrame#SidebarFooter {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 10px;
}

QLabel#StatusDotIdle {
    color: #10B981;
    font-size: 12px;
    font-weight: 700;
}

QLabel#StatusDotActive {
    color: #F59E0B;
    font-size: 12px;
    font-weight: 700;
}

QLabel#HotkeyHint {
    color: #64748B;
    font-size: 11px;
}

/* --- CARDS & CONTAINERS --- */
QFrame#Card, QFrame#SidebarFrame {
    background-color: #111827;
    border: 1px solid #1E293B;
    border-radius: 12px;
}

QFrame#SubCard {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 8px;
}

QGroupBox {
    background-color: #111827;
    border: 1px solid #1E293B;
    border-radius: 12px;
    margin-top: 12px;
    padding: 18px 16px 14px 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 2px 8px;
    background-color: #1E293B;
    color: #93C5FD;
    border: 1px solid #334155;
    border-radius: 5px;
    font-size: 11px;
    font-weight: 700;
}

/* --- TYPOGRAPHY / LABELS --- */
QLabel {
    color: #94A3B8;
}

QLabel#HeaderLabel, QLabel.HeaderLabel {
    font-size: 22px;
    font-weight: 800;
    color: #F8FAFC;
    letter-spacing: -0.2px;
}

QLabel#PageSubtitle {
    font-size: 12px;
    color: #64748B;
    margin-top: 2px;
}

QLabel#SectionLabel, QLabel.SectionLabel {
    font-size: 12px;
    font-weight: 700;
    color: #CBD5E1;
    letter-spacing: 0.3px;
}

QLabel#FieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #94A3B8;
}

QLabel#BadgeLabel {
    background-color: #1E293B;
    color: #38BDF8;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#StatusBanner {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 600;
    color: #94A3B8;
}

/* --- BUTTONS --- */
QPushButton {
    background-color: #1E293B;
    color: #E2E8F0;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #283548;
    border: 1px solid #475569;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #0F172A;
}

QPushButton:disabled {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    color: #475569;
}

/* Preset Pill Buttons */
QPushButton#PresetButton {
    background-color: #0F172A;
    color: #94A3B8;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#PresetButton:hover {
    background-color: #1E293B;
    color: #38BDF8;
    border: 1px solid #0284C7;
}

/* Primary Action Button (Start, Play, Run) */
QPushButton#PrimaryButton, QPushButton.PrimaryButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #3B82F6;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

QPushButton#PrimaryButton:hover, QPushButton.PrimaryButton:hover {
    background-color: #1D4ED8;
    border: 1px solid #60A5FA;
}

QPushButton#PrimaryButton:pressed, QPushButton.PrimaryButton:pressed {
    background-color: #1E40AF;
}

QPushButton#PrimaryButton:disabled, QPushButton.PrimaryButton:disabled {
    background-color: #1E293B;
    border: 1px solid #334155;
    color: #475569;
}

/* Success Button (Add Step, Save) */
QPushButton#SuccessButton, QPushButton.SuccessButton {
    background-color: #059669;
    color: #FFFFFF;
    border: 1px solid #10B981;
    border-radius: 8px;
    font-weight: 700;
}

QPushButton#SuccessButton:hover, QPushButton.SuccessButton:hover {
    background-color: #047857;
    border: 1px solid #34D399;
}

QPushButton#SuccessButton:pressed, QPushButton.SuccessButton:pressed {
    background-color: #065F46;
}

/* Danger Button (Stop, Delete, Record) */
QPushButton#DangerButton, QPushButton.DangerButton {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #EF4444;
    border-radius: 10px;
    font-weight: 700;
}

QPushButton#DangerButton:hover, QPushButton.DangerButton:hover {
    background-color: #B91C1C;
    border: 1px solid #F87171;
}

QPushButton#DangerButton:pressed, QPushButton.DangerButton:pressed {
    background-color: #991B1B;
}

/* --- INPUTS --- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit {
    background-color: #0F172A;
    border: 1px solid #26334D;
    border-radius: 8px;
    padding: 7px 10px;
    color: #F1F5F9;
    font-weight: 500;
    selection-background-color: #2563EB;
}

QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
    border: 1px solid #3B82F6;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #3B82F6;
    background-color: #131C31;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: #0B0F17;
    border: 1px solid #1E293B;
    color: #475569;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 20px;
    background: transparent;
    border-left: 1px solid #1E293B;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #1E293B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #1E293B;
}

QComboBox QAbstractItemView {
    background-color: #0F172A;
    color: #F1F5F9;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
}

/* --- RADIO BUTTONS & CHECKBOXES --- */
QRadioButton, QCheckBox {
    color: #CBD5E1;
    font-size: 13px;
    font-weight: 500;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 9px;
    border: 2px solid #475569;
    background-color: #0F172A;
}

QRadioButton::indicator:hover {
    border: 2px solid #3B82F6;
}

QRadioButton::indicator:checked {
    border: 5px solid #3B82F6;
    background-color: #F8FAFC;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 2px solid #475569;
    background-color: #0F172A;
}

QCheckBox::indicator:hover {
    border: 2px solid #3B82F6;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border: 2px solid #3B82F6;
}

/* --- SLIDERS & PROGRESS BARS --- */
QSlider::groove:horizontal {
    border: 1px solid #1E293B;
    height: 6px;
    background: #0F172A;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #2563EB;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #F8FAFC;
    border: 2px solid #2563EB;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #38BDF8;
    border-color: #FFFFFF;
}

QProgressBar {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 6px;
    height: 10px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #10B981;
    border-radius: 5px;
}

/* --- LISTS / WORKFLOW BUILDER / EVENT LOG --- */
QListWidget {
    background-color: #0F172A;
    border: 1px solid #1E293B;
    border-radius: 10px;
    padding: 4px;
    outline: 0;
}

QListWidget::item {
    background-color: #141D2F;
    border: 1px solid #1E293B;
    border-radius: 6px;
    padding: 9px 12px;
    margin: 2px 2px;
    color: #E2E8F0;
}

QListWidget::item:hover {
    background-color: #1E293B;
    border: 1px solid #334155;
}

QListWidget::item:selected {
    background-color: #2563EB;
    border: 1px solid #60A5FA;
    color: #FFFFFF;
    font-weight: 600;
}

/* --- SCROLLBARS --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #334155;
    min-height: 24px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #475569;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
